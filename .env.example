APP_NAME=InsightAI
APP_VERSION=2.1.0
ENVIRONMENT=development

DATABASE_URL=sqlite:///./insight.db
CONFIDENCE_THRESHOLD=0.32
# Clear winners (top1-top2 >= margin) skip review even if max-prob is soft
CONFIDENCE_MARGIN=0.10
UPLOAD_DIR=data/uploads
MAX_UPLOAD_BYTES=10485760

# Auth: when AUTH_ENABLED=true, API_KEY is required (app fails fast if missing).
AUTH_ENABLED=false
API_KEY=

# When ENVIRONMENT=production|staging, AUTH_ENABLED must be true unless you
# explicitly set this to false (local demos only — never for shared deploys).
REQUIRE_AUTH_IN_PRODUCTION=true

CORS_ORIGINS=http://127.0.0.1:8501,http://localhost:8501,http://127.0.0.1:8502,http://localhost:8502
DEFAULT_PAGE_SIZE=50
MAX_PAGE_SIZE=200

# Frontend
API_BASE_URL=http://127.0.0.1:8000
API_TIMEOUT_SECONDS=20
